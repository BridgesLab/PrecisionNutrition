# .gitignore — Human Genetics (repo root)
#
# Only generic, path-free rules belong here: they match at any depth, so they
# cover every analysis subdirectory. Anything anchored to a particular project
# lives in that project's own .gitignore — see calcium-cholesterol/.gitignore
# for the data and reference-panel rules (~5 GB) that used to sit here.

# ---- Render caches --------------------------------------------------------------
# knitr caches are large (~60 MB for one document) and machine-specific.
*_cache/

# Quarto project state and freeze cache.
.quarto/
_freeze/

# ---- R session noise ------------------------------------------------------------
.Rhistory
.Rapp.history
.RData
.Rproj.user/
.Renviron

# ---- Cluster --------------------------------------------------------------------
logs/
slurm-*.out
*.sbatch.log

# ---- OS -------------------------------------------------------------------------
.DS_Store
._*
